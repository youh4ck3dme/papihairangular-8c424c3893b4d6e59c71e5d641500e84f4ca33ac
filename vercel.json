{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/ensure-env.mjs && pnpm run build:prod",
  "outputDirectory": "dist/app/browser",
  "routes": [
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/booking$",
      "status": 302,
      "headers": {
        "Location": "https://services.bookio.com/papi-hair-design/widget?lang=sk"
      }
    },
    {
      "src": "^/shop$",
      "status": 302,
      "headers": {
        "Location": "https://www.goldhaircare.sk/affiliate/2208"
      }
    },
    {
      "src": "^/(?:ai-studio|ai-stylista|virtualny-stylista|virtual-salon|diagnostika|admin)(?:/.*)?$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/ngsw\\.json$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/ngsw-worker\\.js$",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "^/(?:main|chunk|polyfills|styles)-[A-Z0-9]+\\.(?:js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/media/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(?:assets|images)/.*$",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(cennik|o-nas|kontakt|blog)$",
      "dest": "/$1/index.html",
      "check": true
    },
    {
      "src": "^/(blog|sluzby)/([^/]+)$",
      "dest": "/$1/$2/index.html",
      "check": true
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
