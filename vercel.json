{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/ensure-env.mjs && pnpm run build:prod",
  "outputDirectory": "dist/app/browser",
  "headers": [
    {
      "source": "/ngsw.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ai-studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ai-stylista",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/virtualny-stylista",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/virtual-salon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/diagnostika",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/",
      "permanent": true
    }
  ]
}
