{
  "$schema": "https://design-tokens.github.io/community-group/format",
  "$description": "PAPI HAIR DESIGN — W3C DTCG dizajn tokeny. Jediný zdroj pravdy. Generované do src/styles/tokens.css pomocou scripts/build-tokens.mjs.",
  "color": {
    "gold": {
      "50":  { "$value": "#faf6e7", "$type": "color", "$description": "OKLCH 97% 0.03 95 — jemné zlaté pozadie" },
      "100": { "$value": "#f3ecc9", "$type": "color" },
      "200": { "$value": "#e8d99a", "$type": "color" },
      "300": { "$value": "#dec36a", "$type": "color" },
      "400": { "$value": "#d4af37", "$type": "color", "$description": "Zlatá base; AA len na tmavom pozadí" },
      "500": { "$value": "#b8922b", "$type": "color" },
      "600": { "$value": "#8a6a12", "$type": "color", "$description": "Text zlatá pre svetlé pozadia (AA 5,06:1 na bielom)" },
      "700": { "$value": "#6b530e", "$type": "color" },
      "800": { "$value": "#4a3908", "$type": "color" },
      "900": { "$value": "#2a2005", "$type": "color" }
    },
    "neutral": {
      "0":   { "$value": "#ffffff", "$type": "color" },
      "50":  { "$value": "#f7f5f0", "$type": "color", "$description": "Teplé biele pozadie sekcie — charakteristický odtieň značky" },
      "100": { "$value": "#e9e7e2", "$type": "color" },
      "400": { "$value": "#a1a1aa", "$type": "color" },
      "500": { "$value": "#71717a", "$type": "color" },
      "600": { "$value": "#52525b", "$type": "color" },
      "800": { "$value": "#171717", "$type": "color" },
      "900": { "$value": "#121212", "$type": "color" },
      "950": { "$value": "#0a0a0a", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#166534", "$type": "color", "$description": "Otvorené; AA proti bielemu 7,8:1 aj na pastelovom pozadí pilulky" },
      "danger":  { "$value": "#b91c1c", "$type": "color", "$description": "Chyba formulára; AA proti bielemu 6,4:1" },
      "focus":   { "$value": "#8a6a12", "$type": "color", "$description": "Focus ring, rovnaký odtieň ako accent-text" }
    }
  },
  "space": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "8px",    "$type": "dimension" },
    "md":   { "$value": "16px",   "$type": "dimension" },
    "lg":   { "$value": "24px",   "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "size": {
    "container":  { "$value": "1200px", "$type": "dimension" },
    "pad-x":      { "$value": "20px",   "$type": "dimension" },
    "pad-x-md":   { "$value": "48px",   "$type": "dimension" },
    "header-h":   { "$value": "56px",   "$type": "dimension" },
    "cta-h":      { "$value": "56px",   "$type": "dimension" },
    "touch":      { "$value": "44px",   "$type": "dimension", "$description": "Minimálna cieľová plocha WCAG 2.5.5" }
  },
  "font": {
    "family": {
      "body":    { "$value": "'Satoshi', 'Satoshi Fallback', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "heading": { "$value": "'Satoshi', 'Satoshi Fallback', system-ui, -apple-system, 'Segoe UI', sans-serif",  "$type": "fontFamily" }
    },
    "size": {
      "body":    { "$value": "clamp(16px, 1rem + 0.1vw, 18px)", "$type": "dimension" },
      "lead":    { "$value": "clamp(17px, 1rem + 0.5vw, 20px)", "$type": "dimension" },
      "h3":      { "$value": "clamp(22px, 1.1rem + 1.5vw, 32px)", "$type": "dimension" },
      "h2":      { "$value": "clamp(28px, 1.2rem + 2.5vw, 44px)", "$type": "dimension" },
      "h1":      { "$value": "clamp(34px, 1.3rem + 4.5vw, 60px)", "$type": "dimension" },
      "eyebrow": { "$value": "12px", "$type": "dimension" }
    },
    "weight": {
      "body":    { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "semibold":{ "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    },
    "line": {
      "body":    { "$value": "1.6",  "$type": "number" },
      "heading": { "$value": "1.1",  "$type": "number" }
    },
    "track": {
      "eyebrow": { "$value": "0.2em", "$type": "dimension" }
    }
  },
  "shadow": {
    "sm": { "$value": "0 2px 8px rgba(0,0,0,0.08)",   "$type": "shadow" },
    "md": { "$value": "0 8px 24px rgba(0,0,0,0.12)",  "$type": "shadow" },
    "lg": { "$value": "0 16px 40px -20px rgba(0,0,0,0.35)", "$type": "shadow" }
  },
  "z": {
    "base":   { "$value": "1",   "$type": "number" },
    "header": { "$value": "40",  "$type": "number" },
    "modal":  { "$value": "80",  "$type": "number" },
    "toast":  { "$value": "100", "$type": "number" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "300ms", "$type": "duration" },
      "hero": { "$value": "800ms", "$type": "duration" }
    },
    "easing": {
      "out":    { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" },
      "in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier" }
    }
  },
  "theme": {
    "light": {
      "color": {
        "surface":        { "$value": "{color.neutral.0}",   "$type": "color" },
        "surface-alt":    { "$value": "{color.neutral.50}",  "$type": "color" },
        "text":           { "$value": "{color.neutral.800}", "$type": "color" },
        "text-muted":     { "$value": "{color.neutral.600}", "$type": "color" },
        "border":         { "$value": "rgba(23,23,23,0.10)", "$type": "color" },
        "border-strong":  { "$value": "rgba(23,23,23,0.35)", "$type": "color", "$description": "3:1 pre inputy a ovládacie prvky WCAG 1.4.11" },
        "card":           { "$value": "{color.neutral.0}",   "$type": "color" },
        "accent-text":    { "$value": "{color.gold.600}",    "$type": "color", "$description": "Zlatá na svetlom pozadí ako text (AA 5,06:1)" },
        "accent-fill":    { "$value": "{color.gold.400}",    "$type": "color", "$description": "Zlatá ako plocha, ikony a tlačidlá" },
        "on-accent":      { "$value": "{color.neutral.800}", "$type": "color" },
        "overlay":        { "$value": "rgba(0,0,0,0.5)",     "$type": "color" }
      }
    },
    "dark": {
      "color": {
        "surface":        { "$value": "{color.neutral.950}", "$type": "color" },
        "surface-alt":    { "$value": "{color.neutral.900}", "$type": "color" },
        "text":           { "$value": "#f5f5f5",             "$type": "color" },
        "text-muted":     { "$value": "{color.neutral.400}", "$type": "color" },
        "border":         { "$value": "rgba(212,175,55,0.15)", "$type": "color" },
        "border-strong":  { "$value": "rgba(212,175,55,0.45)", "$type": "color" },
        "card":           { "$value": "{color.neutral.800}", "$type": "color" },
        "accent-text":    { "$value": "{color.gold.400}",    "$type": "color", "$description": "Na tmavom pozadí 8,5–9,4:1" },
        "accent-fill":    { "$value": "{color.gold.400}",    "$type": "color" },
        "on-accent":      { "$value": "{color.neutral.800}", "$type": "color" },
        "overlay":        { "$value": "rgba(0,0,0,0.7)",     "$type": "color" }
      }
    }
  }
}
