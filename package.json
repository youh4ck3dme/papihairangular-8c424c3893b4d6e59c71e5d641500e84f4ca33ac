{
  "name": "papihairdesign-angular",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm ng serve --ssl --proxy-config proxy.conf.json --port 3002",
    "start": "pnpm run dev",
    "build": "pnpm ng build",
    "build:prod": "pnpm ng build --configuration=production",
    "serve:prod": "pnpm ng serve --configuration=production",
    "preview": "pnpm ng serve --configuration=production",
    "test:sw": "pnpm run build:prod && pnpm exec http-server dist/app/browser -p 8080 -c-1",
    "lint": "pnpm ng lint",
    "test": "pnpm ng test",
    "dev:ssr": "pnpm ng run app:serve-ssr",
    "serve:ssr": "node dist/app/server/main.js",
    "build:ssr": "pnpm ng build && pnpm ng run app:server",
    "prerender": "pnpm ng run app:prerender",
    "test:visual": "pnpm exec backstop test",
    "test:visual:reference": "pnpm exec backstop reference",
    "test:visual:approve": "pnpm exec backstop approve",
    "test:visual:report": "pnpm exec backstop openReport",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "preinstall": "echo '⚠️  POZOR: Verzie sú zamknuté. Pred upgradom si prečítaj VERSIONS.md'"
  },
  "dependencies": {
    "@angular/animations": "20.3.15",
    "@angular/build": "20.3.13",
    "@angular/cli": "20.3.13",
    "@angular/common": "20.3.15",
    "@angular/compiler": "20.3.15",
    "@angular/compiler-cli": "20.3.15",
    "@angular/core": "20.3.15",
    "@angular/forms": "20.3.15",
    "@angular/platform-browser": "20.3.15",
    "@angular/platform-browser-dynamic": "20.3.15",
    "@angular/platform-server": "20.3.15",
    "@angular/router": "20.3.15",
    "@angular/service-worker": "20.3.15",
    "@angular/ssr": "20.3.13",
    "@google/genai": "1.27.0",
    "express": "5.1.0",
    "firebase": "12.6.0",
    "openai": "6.9.1",
    "rxjs": "7.8.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.13",
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.57.0",
    "@types/express": "5.0.1",
    "@types/jasmine": "5.1.13",
    "@types/node": "20.19.27",
    "angular-eslint": "21.0.1",
    "autoprefixer": "10.4.22",
    "backstopjs": "6.3.25",
    "browser-sync": "3.0.0",
    "eslint": "9.39.1",
    "jasmine-core": "5.13.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss": "8.5.5",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.46.4"
  }
}
