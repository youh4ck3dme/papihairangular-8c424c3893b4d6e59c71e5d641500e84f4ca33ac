{
  "name": "papihairdesign-angular",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm ng serve --ssl --port 3002",
    "start": "pnpm run dev",
    "build": "pnpm ng build",
    "build:prod": "node scripts/gen-sitemap.mjs && pnpm ng build --configuration=production && node scripts/postbuild.mjs",
    "build:vps": "pnpm run build:prod && node scripts/precompress.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "test:site": "playwright test -c e2e/site.config.ts",
    "lh": "lhci autorun --config=lighthouserc.json",
    "serve:prod": "pnpm ng serve --configuration=production",
    "preview": "pnpm ng serve --configuration=production",
    "test:sw": "pnpm run build:prod && node scripts/serve-dist.mjs 8080",
    "lint": "pnpm ng lint",
    "test": "pnpm ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "preinstall": "echo '⚠️  POZOR: Verzie sú zamknuté. Pred upgradom si prečítaj VERSIONS.md'",
    "serve:dist": "node scripts/serve-dist.mjs 4300",
    "test:unit": "pnpm ng test --watch=false --browsers=ChromeHeadlessCI",
    "bench:scroll": "node scripts/scroll-bench.mjs",
    "gen:images": "node scripts/gen-images.mjs"
  },
  "dependencies": {
    "@angular/build": "20.3.13",
    "@angular/cli": "20.3.13",
    "@angular/common": "20.3.15",
    "@angular/compiler": "20.3.15",
    "@angular/compiler-cli": "20.3.15",
    "@angular/core": "20.3.15",
    "@angular/forms": "20.3.15",
    "@angular/platform-browser": "20.3.15",
    "@angular/platform-browser-dynamic": "20.3.15",
    "@angular/platform-server": "20.3.15",
    "@angular/router": "20.3.15",
    "@angular/service-worker": "20.3.15",
    "@angular/ssr": "20.3.13",
    "rxjs": "7.8.2",
    "web-vitals": "5.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.13",
    "@axe-core/playwright": "4.11.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.57.0",
    "@types/jasmine": "5.1.13",
    "@types/node": "20.19.27",
    "angular-eslint": "21.0.1",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "jasmine-core": "5.13.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss": "8.5.5",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.46.4"
  }
}
