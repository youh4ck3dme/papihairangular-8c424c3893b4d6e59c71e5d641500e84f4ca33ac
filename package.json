{
  "name": "papihairdesign-angular",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm ng serve --ssl --proxy-config proxy.conf.json --port 3002",
    "start": "pnpm run dev",
    "build": "pnpm ng build",
    "build:prod": "pnpm ng build --configuration=production",
    "serve:prod": "pnpm ng serve --configuration=production",
    "preview": "pnpm ng serve --configuration=production",
    "test:sw": "pnpm run build:prod && pnpm exec http-server dist/app/browser -p 8080 -c-1",
    "lint": "pnpm ng lint",
    "test": "pnpm ng test",
    "dev:ssr": "pnpm ng run app:serve-ssr",
    "serve:ssr": "node dist/app/server/main.js",
    "build:ssr": "pnpm ng build && pnpm ng run app:server",
    "prerender": "pnpm ng run app:prerender",
    "test:visual": "pnpm exec backstop test",
    "test:visual:reference": "pnpm exec backstop reference",
    "test:visual:approve": "pnpm exec backstop approve",
    "test:visual:report": "pnpm exec backstop openReport",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@angular/animations": "^20.3.13",
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.7",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.15",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.7",
    "@angular/service-worker": "^20.3.7",
    "@angular/ssr": "^20.3.12",
    "@google/genai": "^1.27.0",
    "express": "^5.1.0",
    "firebase": "^12.6.0",
    "openai": "^6.9.1",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.11",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "^5.1.13",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.22",
    "backstopjs": "^6.3.25",
    "browser-sync": "^3.0.0",
    "eslint": "^9.39.1",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.46.4"
  }
}